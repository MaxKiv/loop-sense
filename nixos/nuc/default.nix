{
  inputs,
  config,
  username,
  hostname,
  pkgs,
  lib,
  sshPublicKeys,
  ...
}: {
  imports = [
    # Generated by `nixos-generate-config` on the NUC (see below).
    # Provides fileSystems, boot.initrd modules, kernel modules, and CPU microcode.
    ./hardware-configuration.nix

    # generic Intel CPU tweaks from nixos-hardware.
    inputs.nixos-hardware.nixosModules.common-cpu-intel
    inputs.nixos-hardware.nixosModules.common-pc-ssd

    ./network.nix
    ./user.nix
    ./pkgs.nix
    ./ssh.nix
    ./virt.nix
    ./influxdb.nix
    ./uart.nix
    ./loop-sense.nix
    ./heart-os.nix
  ];

  nix.settings.experimental-features = ["nix-command" "flakes"];

  # Trust users in the wheel (sudo) group, used to rebuild over ssh
  nix.settings.trusted-users = ["@wheel"];

  # Intel WiFi/BT firmware + microcode updates
  hardware.enableRedistributableFirmware = true;
  hardware.cpu.intel.updateMicrocode = true;

  # Bootloader (NUCs are UEFI). 
  boot.loader.systemd-boot.enable = true;
  boot.loader.systemd-boot.configurationLimit = 10;
  boot.loader.efi.canTouchEfiVariables = true;

  # Optional: swap. NUCs usually have plenty of RAM, so a smaller swap
  # or zram is often better than a 4GB swapfile on SSD.
  swapDevices = [{ device = "/swapfile"; size = 4 * 1024; }];

  # useful tooling
  environment.systemPackages = with pkgs; [
    pciutils
    usbutils
    lm_sensors
    smartmontools
    nvme-cli
  ];

  # SSD health checks
  services.fstrim.enable = true;

  powerManagement.cpuFreqGovernor = "performance";  # or "schedutil" for mid

  system.stateVersion = "25.05";
}
